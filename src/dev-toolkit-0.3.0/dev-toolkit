#!/usr/bin/env bash
# dev-toolkit - quick developer setup after switching distro
# SPDX-License-Identifier: GPL-3.0-or-later

set -u

VERSION="0.3.0"
SELF_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

DATA_DIR=""
for d in "$SELF_DIR" "$SELF_DIR/../share/dev-toolkit" /usr/local/share/dev-toolkit /usr/share/dev-toolkit; do
    if [[ -d $d/toolkits ]]; then DATA_DIR=$d; break; fi
done
if [[ -z $DATA_DIR ]]; then echo "error: toolkits directory not found" >&2; exit 1; fi

AUTO_HI=70      # similarity >= this: substitute the closest name automatically...
AUTO_MINLEN=5   # ...but only for names at least this long (short names are too ambiguous)
AUTO_LO=30      # similarity <  this: package not found

ASSUME_YES=0
DRY_RUN=0
PRESELECT=""
BACKEND=""
SET=()
SELECTED=()
KEEPALIVE_PID=""
TMP="$(mktemp -d)"
declare -A MAP=()
declare -A BACKEND_CMD=([pacman]=pacman [apt]=apt-get [dnf]=dnf [zypper]=zypper)
BACKEND_ORDER=(pacman apt dnf zypper)

if [[ -t 1 ]]; then
    B=$'\e[1m'; Y=$'\e[33m'; R=$'\e[31m'; N=$'\e[0m'
else
    B=""; Y=""; R=""; N=""
fi
info() { printf '%s\n' "$*"; }
warn() { printf '%s%s%s\n' "$Y" "$*" "$N" >&2; }
err()  { printf '%s%s%s\n' "$R" "$*" "$N" >&2; }

cleanup() {
    [[ -n $KEEPALIVE_PID ]] && kill "$KEEPALIVE_PID" 2>/dev/null
    rm -rf "$TMP"
}
trap cleanup EXIT
trap 'exit 130' INT

usage() {
    cat <<'USAGE'
Usage: dev-toolkit [options]

Options:
  -t, --toolkits LIST  comma-separated toolkits (skips the menu), e.g. web,devops
                       "all" selects every toolkit (with -n it works as a check)
  -b, --backend NAME   package manager: pacman, apt, dnf, zypper (default: auto-detect)
  -y, --yes            no prompts: install base + selected toolkits as they are
  -n, --dry-run        print the install command instead of running it
  -l, --list           list available toolkits
  -h, --help           show this help
  -v, -V, --version    show version
USAGE
}

# Run a command, or only print it in dry-run mode. Used by the backends.
run_or_print() {
    if (( DRY_RUN )); then
        printf '%q ' "$@"; echo
    else
        "$@"
    fi
}

# ---------- toolkits ----------

toolkit_names() {
    local f
    for f in "$DATA_DIR"/toolkits/*.list; do
        f=${f##*/}; f=${f%.list}
        [[ $f == base ]] || printf '%s\n' "$f"
    done
}
toolkit_desc() { sed -n 's/^# desc: *//p' "$DATA_DIR/toolkits/$1.list" | head -n1; }
toolkit_pkgs() { sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$DATA_DIR/toolkits/$1.list"; }

mapfile -t TOOLKITS < <(toolkit_names)

list_toolkits() {
    local i
    for i in "${!TOOLKITS[@]}"; do
        printf '  %d) %-10s %s\n' "$((i + 1))" "${TOOLKITS[i]}" "$(toolkit_desc "${TOOLKITS[i]}")"
    done
}

# ---------- arguments ----------

while (($#)); do
    case $1 in
        -t|--toolkits)
            [[ $# -ge 2 ]] || { err "$1 needs a value"; exit 2; }
            PRESELECT=$2; shift 2 ;;
        -b|--backend)
            [[ $# -ge 2 ]] || { err "$1 needs a value"; exit 2; }
            BACKEND=$2; shift 2 ;;
        -y|--yes)     ASSUME_YES=1; shift ;;
        -n|--dry-run) DRY_RUN=1; shift ;;
        -l|--list)    list_toolkits; exit 0 ;;
        -h|--help)    usage; exit 0 ;;
        -v|-V|--version) echo "dev-toolkit $VERSION"; exit 0 ;;
        *) err "unknown option: $1"; usage >&2; exit 2 ;;
    esac
done

# ---------- backend ----------

SUDO=(sudo)
(( EUID == 0 )) && SUDO=()

detect_backend() {
    local b
    if [[ -n $BACKEND ]]; then
        if [[ -z ${BACKEND_CMD[$BACKEND]:-} ]]; then
            err "unknown backend: $BACKEND (available: ${BACKEND_ORDER[*]})"; exit 2
        fi
        if ! command -v "${BACKEND_CMD[$BACKEND]}" >/dev/null 2>&1; then
            err "backend $BACKEND selected, but ${BACKEND_CMD[$BACKEND]} is not installed"; exit 1
        fi
        return
    fi
    for b in "${BACKEND_ORDER[@]}"; do
        if command -v "${BACKEND_CMD[$b]}" >/dev/null 2>&1; then BACKEND=$b; return; fi
    done
    err "No supported package manager found (supported: ${BACKEND_ORDER[*]})."
    exit 1
}

# Package names: from cache for slow backends (BACKEND_CACHE_TTL > 0), else live.
load_names() {
    local ttl=${BACKEND_CACHE_TTL:-0}
    local cache="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/dev-toolkit/$BACKEND.names"
    if (( ttl > 0 )) && [[ -s $cache ]] && (( $(date +%s) - $(stat -c %Y "$cache") < ttl )); then
        cp "$cache" "$PKGS_FILE"
        return
    fi
    (( ttl > 0 )) && info "Loading package list (cached for later runs)..."
    backend_packages >"$PKGS_FILE"
    if (( ttl > 0 )) && [[ -s $PKGS_FILE ]]; then
        mkdir -p "${cache%/*}" 2>/dev/null && cp "$PKGS_FILE" "$cache" 2>/dev/null
    fi
}

load_map() {
    local f="$DATA_DIR/maps/$BACKEND.map" line
    [[ -f $f ]] || return 0
    while IFS= read -r line; do
        if [[ $line =~ ^[[:space:]]*([^#=[:space:]]+)[[:space:]]*=[[:space:]]*([^#]*[^#[:space:]])[[:space:]]*(#.*)?$ ]]; then
            MAP[${BASH_REMATCH[1]}]=${BASH_REMATCH[2]}
        fi
    done <"$f"
}

init_backend() {
    detect_backend
    if (( EUID != 0 && DRY_RUN == 0 )) && ! command -v sudo >/dev/null 2>&1; then
        err "sudo not found: run as root or install sudo."
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$DATA_DIR/backends/$BACKEND.sh"

    PKGS_FILE="$TMP/pkgs"; GROUPS_FILE="$TMP/groups"; NAMES_FILE="$TMP/names"
    load_names
    backend_groups >"$GROUPS_FILE"
    cat "$PKGS_FILE" "$GROUPS_FILE" >"$NAMES_FILE"
    if [[ ! -s $PKGS_FILE ]]; then
        err "Package database is empty. Run: $BACKEND_HINT"
        exit 1
    fi
    load_map
}

# ---------- the set ----------

in_set() {
    local x
    for x in "${SET[@]}"; do [[ $x == "$1" ]] && return 0; done
    return 1
}

# Groups (pacman) are expanded into their members: a group would trigger a selection prompt.
add_to_set() {
    local n=$1 m
    if grep -Fxq -- "$n" "$GROUPS_FILE" && ! grep -Fxq -- "$n" "$PKGS_FILE"; then
        while read -r m; do
            in_set "$m" || SET+=("$m")
        done < <(backend_group_members "$n")
    else
        in_set "$n" || SET+=("$n")
    fi
}

show_set() {
    printf '\n%sCurrent set (%d packages):%s\n' "$B" "${#SET[@]}" "$N"
    printf '%s\n' "${SET[@]}" | { column -c "${COLUMNS:-80}" 2>/dev/null || cat; }
    echo
}

ask_yes() {
    local a
    read -r -p "$1" a || { echo; err "aborted"; exit 130; }
    [[ -z $a || $a =~ ^[Yy] ]]
}

# ---------- commands ----------

add_resolved() {   # $1 = resolved name
    if in_set "$1"; then
        info "$1: already in list"
    else
        add_to_set "$1"
        info "+ $1"
    fi
}

cmd_add() {
    local p=${1,,} res score best
    if in_set "$p"; then info "$p: already in list"; return; fi
    if grep -Fxq -- "$p" "$NAMES_FILE"; then add_resolved "$p"; return; fi

    [[ -t 2 ]] && printf 'searching...' >&2
    res=$(awk -v query="$p" -v min="$AUTO_LO" -f "$DATA_DIR/lib/fuzzy.awk" "$NAMES_FILE" "$NAMES_FILE")
    [[ -t 2 ]] && printf '\r\033[K' >&2
    if [[ -z $res ]]; then warn "package not found: $p"; return; fi
    score=${res%% *}; best=${res#* }

    if (( score < AUTO_LO )); then
        warn "package not found: $p"
    elif (( score >= AUTO_HI && ${#p} >= AUTO_MINLEN )); then
        info "$p -> $best"
        add_resolved "$best"
    elif ask_yes "$p not found. Did you mean $best? [Y/n] "; then
        add_resolved "$best"
    else
        info "not added: $p"
    fi
}

cmd_del() {
    local p=${1,,} i
    for i in "${!SET[@]}"; do
        if [[ ${SET[i]} == "$p" ]]; then
            unset 'SET[i]'
            SET=("${SET[@]}")
            info "- $p"
            return
        fi
    done
    warn "package not found in list"
}

edit_loop() {
    local line cmd rest w
    local -a words
    show_set
    info "Commands: add <pkg...> | del <pkg...> | list | done   (Enter = done)"
    while true; do
        read -r -p "> " line || { echo; err "aborted"; exit 130; }
        read -r cmd rest <<<"$line"
        read -ra words <<<"${rest:-}"
        case ${cmd,,} in
            add)
                ((${#words[@]})) || { warn "usage: add <pkg...>"; continue; }
                for w in "${words[@]}"; do cmd_add "$w"; done ;;
            del|rm)
                ((${#words[@]})) || { warn "usage: del <pkg...>"; continue; }
                for w in "${words[@]}"; do cmd_del "$w"; done ;;
            list|ls) show_set ;;
            done|"") return ;;
            quit|exit|q) info "Cancelled."; exit 0 ;;
            help|"?") info "Commands: add <pkg...> | del <pkg...> | list | done" ;;
            *) warn "unknown command: $cmd (try: add, del, list, done)" ;;
        esac
    done
}

# ---------- flow ----------

select_toolkits() {
    local input tok
    if [[ -n $PRESELECT ]]; then
        input=${PRESELECT//,/ }
    elif (( ASSUME_YES )); then
        input=""
    else
        printf '\n%sToolkits%s (base is always included):\n' "$B" "$N"
        list_toolkits
        read -r -p "Select toolkits (numbers or names, e.g. 2 3; \"all\"; Enter = base only): " input \
            || { echo; err "aborted"; exit 130; }
        input=${input//,/ }
    fi
    for tok in $input; do
        if [[ $tok == all ]]; then SELECTED=("${TOOLKITS[@]}"); continue; fi
        if [[ $tok =~ ^[0-9]+$ ]]; then
            tok=$((10#$tok))
            if (( tok < 1 || tok > ${#TOOLKITS[@]} )); then warn "no such toolkit: $tok"; continue; fi
            tok=${TOOLKITS[tok-1]}
        fi
        if [[ " ${TOOLKITS[*]} " != *" $tok "* ]]; then warn "no such toolkit: $tok"; continue; fi
        [[ " ${SELECTED[*]:-} " == *" $tok "* ]] || SELECTED+=("$tok")
    done
}

# "a|b|c" -> first alternative that exists in this distro's repositories.
# "@name" is a package group (dnf) and is not checked.
resolve_token() {
    local alt
    local IFS='|'
    for alt in $1; do
        if [[ $alt == @* ]] || grep -Fxq -- "$alt" "$NAMES_FILE"; then
            printf '%s' "$alt"; return 0
        fi
    done
    return 1
}

# Toolkit files hold canonical (Arch) names; maps/<backend>.map translates them.
build_set() {
    local t p tok r val
    local -a skipped=()
    for t in base ${SELECTED[@]+"${SELECTED[@]}"}; do
        while read -r p; do
            val=${MAP[$p]-$p}
            for tok in $val; do
                [[ $tok == - ]] && continue
                if r=$(resolve_token "$tok"); then add_to_set "$r"; else skipped+=("$p"); fi
            done
        done < <(toolkit_pkgs "$t")
    done
    if ((${#skipped[@]})); then warn "Skipped (not in repositories): ${skipped[*]}"; fi
}

start_sudo_keepalive() {
    sudo -v || { err "sudo authentication failed"; exit 1; }
    ( while kill -0 "$$" 2>/dev/null; do sudo -n true 2>/dev/null; sleep 50; done ) &
    KEEPALIVE_PID=$!
}

do_install() {
    if (( ${#SET[@]} == 0 )); then warn "Nothing to install."; return; fi
    if (( ! ASSUME_YES )); then
        ask_yes "Install ${#SET[@]} packages? [Y/n] " || { info "Cancelled."; exit 0; }
    fi
    if (( ! DRY_RUN && EUID != 0 )); then start_sudo_keepalive; fi
    backend_install "${SET[@]}"
}

init_backend
select_toolkits
build_set
(( ASSUME_YES )) || edit_loop
do_install
